{
  "name": "kayrelabs",
  "version": "1.0.0",
  "description": "Sitio web de KayreLabs: impresión 3D, electrónica, domótica, desarrollo y diseño.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "sass": "sass --style=compressed --no-charset --quiet-deps --silence-deprecation=import,global-builtin,color-functions,mixed-decls scss/style.scss public/css/style.css",
    "sass:watch": "sass --watch --style=compressed --no-charset --quiet-deps --silence-deprecation=import,global-builtin,color-functions,mixed-decls scss/style.scss public/css/style.css",
    "vendor": "node scripts/vendor.js",
    "build": "npm run sass && npm run vendor",
    "dev": "node server.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "sass": "^1.100.0"
  }
}
